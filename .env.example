# Database (Gunakan SQLite untuk dev lokal tanpa setup, atau ganti ke PostgreSQL/MySQL)
DATABASE_URL="file:./dev.db"

# Admin Seed (Ubah sebelum menjalankan npm run db:seed)
ADMIN_EMAIL="admin@kantor.local"
ADMIN_PASSWORD="ganti-dengan-password-kuat-anda"

# Session Security (Wajib string acak minimal 32 karakter untuk produksi)
SESSION_SECRET="ganti-dengan-secret-acak-minimal-32-karakter-keamanan"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
